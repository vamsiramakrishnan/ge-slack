# ge-slack configuration. Copy to .env for local development; never commit real values.

# --- Slack (single workspace) -------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
# HTTP mode (Cloud Run): signing secret. Local dev: use Socket Mode with an app-level token instead.
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_APP_ID=A0...
SLACK_TEAM_ID=T0...
# Required: workspace subdomain (acme → acme.slack.com), used for permalinks
SLACK_TEAM_DOMAIN=acme
PORT=3000

# --- Gemini Enterprise (Discovery Engine) --------------------------------------------------
GE_PROJECT=my-project
# Residency pin: a region ("eu", "us") or the explicit value "global". Never left empty.
GE_LOCATION=eu
GE_ENGINE=my-gemini-enterprise-app
# GE_COLLECTION=default_collection
# GE_ASSISTANT=default_assistant
# GE_MODEL_ID=
# Optional transparent egress proxy (https only)
# GE_PROXY_URL=
# Skill agents (see skill/README.md): full agent resource names + "label|uri" mention markers
GE_PLANNER_SKILL=
GE_PLANNER_SKILL_MENTION=
GE_COMMANDER_SKILL=
GE_COMMANDER_SKILL_MENTION=

# --- User identity: IdP linking + Workforce Identity Federation ----------------------------
# oidc = Entra/Okta/Ping through WIF; google = Cloud Identity / Workspace users (no STS hop)
IDP_KIND=oidc
IDP_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_DISPLAY_NAME=Acme SSO
# The OAuth redirect is ${PUBLIC_BASE_URL}/oauth/callback — register it with the IdP.
PUBLIC_BASE_URL=https://ge-slack.example.com
WIF_POOL_ID=
WIF_PROVIDER_ID=
# WIF_USER_PROJECT=
# enforce = IdP email must match the Slack profile email (required in production)
GE_EMAIL_BINDING=enforce
# GE_EMAIL_DOMAIN_ALIASES=acme.io=acme.com

# --- Service identity (GE-licensed service account, keyless) -------------------------------
# none | metadata (runtime SA is the licensed SA) | impersonate (runtime SA has TokenCreator on it)
GE_SERVICE_MODE=none
# GE_SERVICE_ACCOUNT=gemini-slack@my-project.iam.gserviceaccount.com

# --- Secrets at rest ------------------------------------------------------------------------
# Production (required): Cloud KMS envelope keys. Generate a 32-byte data key, encrypt it with KMS,
# and pass only the ciphertext:  openssl rand 32 | gcloud kms encrypt --key ... --plaintext-file=- --ciphertext-file=- | base64
# GE_SLACK_KMS_KEY=projects/P/locations/eu/keyRings/ge-slack/cryptoKeys/vault
# GE_SLACK_WRAPPED_KEYS=k1=<base64 ciphertext>
# Development only (refused when NODE_ENV=production): a static key, openssl rand -base64 32
GE_SLACK_VAULT_KEY=
GE_SLACK_VAULT_KEY_ID=k1
# Rotation: previous keys stay readable, e.g. k0=<base64>
# GE_SLACK_VAULT_OLD_KEYS=

# --- Storage, catalog, schedules ------------------------------------------------------------
# memory (dev only) | firestore
GE_STORE=memory
# FIRESTORE_DATABASE=(default)
# @ sources: [{"alias":"runbooks","title":"Incident runbooks","dataStore":"projects/.../dataStores/...","serviceAllowed":true}]
GE_SOURCES_FILE=./sources.example.json
# @ agents (ADR-0002): kind assistant | deep-research | a2a; agentId = last segment of the name
# GE_AGENTS_FILE=./agents.example.json
# Gemini Enterprise web app, linked when a person must authorize a connector or agent
# GE_APP_URL=https://vertexaisearch.cloud.google.com/home/cid/<config-id>
# off = route skills by mention only (if skill turns return 500 on your tenant)
# GE_SKILL_AGENTS_SPEC=on
# Production: Cloud Scheduler calls POST /cron/tick with a Google-signed OIDC token for this SA.
# GE_CRON_INVOKER=ge-slack-scheduler@my-proj.iam.gserviceaccount.com
# Dev only (when GE_CRON_INVOKER is unset): shared secret sent as X-GE-Cron-Secret
GE_CRON_SECRET=
GE_TIME_ZONE=UTC
NODE_ENV=development
